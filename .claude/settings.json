{
  "extraKnownMarketplaces": {
    "glw907-standards": {
      "source": { "source": "github", "repo": "glw907/standards" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "standards@glw907-standards": true
  },
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(node scripts/checks/fast-lane.mjs*)",
      "Bash(node scripts/checks/gate-tier.mjs *)",
      "Bash(npm run lane:fast*)",
      "Bash(npm run check*)",
      "Bash(npm test*)",
      "Bash(npm run test:*)",
      "Bash(make -C tool check)",
      "Bash(node scripts/release/*)",
      "Bash(gh workflow run publish.yml --ref v* -f promote=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-cut-guard.mjs\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
