{
  "name": "cairn-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "predev": "npm run build:admin-css",
    "dev:admin-css": "npx --no-install @tailwindcss/cli -i src/admin.css -o .cairn/admin.css --watch",
    "build": "vite build",
    "prebuild": "npm run build:admin-css",
    "preview": "vite preview",
    "cairn:manifest": "cairn-manifest",
    "build:admin-css": "npx --no-install @tailwindcss/cli -i src/admin.css -o .cairn/admin.css",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "precheck": "npm run build:admin-css",
    "check:cairn": "npm run build:admin-css && cairn-audit",
    "check:cairn:rendered": "cairn-audit --rendered",
    "format": "prettier --write --no-error-on-unmatched-pattern 'src/**/*.{ts,js,svelte,css}' 'e2e/**/*.ts' '*.ts' '*.js'",
    "format:check": "prettier --check --no-error-on-unmatched-pattern 'src/**/*.{ts,js,svelte,css}' 'e2e/**/*.ts' '*.ts' '*.js'",
    "pretest:e2e": "npm --prefix ../.. run package",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "design:probe": "node scripts/design-probe.mjs"
  },
  "dependencies": {
    "@glw907/cairn-cms": "file:../..",
    "hastscript": "^9.0.1",
    "remark-smartypants": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/source-code-pro": "^5.2.5",
    "@fontsource-variable/source-sans-3": "^5.2.5",
    "@glw907/cairn-cms-dev": "file:../../packages/cairn-cms-dev",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.13.6",
    "daisyui": "^5.7.44",
    "devalue": "^5.9.4",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6",
    "vite": "^8.3.0",
    "vitest": "^4.1",
    "wrangler": "^4.137.0"
  }
}
