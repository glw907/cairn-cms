{
  // The deployable template's Cloudflare Worker config. A scaffolded site keeps this shape and
  // swaps the names and ids. Modeled on the live 907-life cairn site.
  "name": "cairn-showcase",
  "compatibility_date": "2026-08-21",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    // "none" (the schema's own default) is set explicitly: for a request that matches no static
    // asset, Cloudflare passes it through to this Worker instead of intercepting it at the edge.
    // The `(site)` route group prerenders every page, so SvelteKit strips its `[...path]`
    // catch-all from the runtime-routable manifest entirely; an unmatched path therefore matches
    // no route at request time, and the Worker's own bundled SvelteKit server falls through to
    // its built-in default-404 handling, which renders the root `+error.svelte`
    // (src/routes/+error.svelte) through a real SSR response. Setting this to "404-page" would
    // instead serve a static, unthemed file straight from the edge and never reach the Worker at
    // all (see src/chassis/README.md's "The themed-404 pattern").
    "not_found_handling": "none"
  },
  // Email Sending binding for magic links (arbitrary recipients). A real site sets remote = true
  // so `wrangler dev` sends real mail; the dev backend fakes it locally.
  "send_email": [{ "name": "EMAIL" }],
  // cairn-cms self-owned magic-link auth store (editor allowlist, sessions, tokens). Each
  // database gets its own migrations_dir: a channel database sharing the default migrations/
  // directory with AUTH_DB would cross-apply schemas neither side expects.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "cairn-showcase-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      // The developer's own database, holding the signups table /admin/signups reads. Its own
      // migrations_dir, never "migrations": `wrangler d1 migrations apply` walks one directory
      // per database, so a shared directory applies every schema to both.
      "binding": "APP_DB",
      "database_name": "cairn-showcase-app",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-app"
    }
    // cairn-template:exclude-start
    ,
    {
      // The showcase members fixture's own D1 binding (docs/extend/add-a-second-audience.md).
      // Its own migrations_dir, never "migrations": sharing AUTH_DB's directory would apply
      // this channel's schema against the auth store and vice versa.
      "binding": "MEMBER_DB",
      "database_name": "cairn-showcase-members",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations-members"
    }
    // cairn-template:exclude-end
  ],
  // R2 bucket backing the media library; the /media route streams content-addressed bytes from here.
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "cairn-showcase-media" }],
  "vars": {
    // Canonical origin for magic-link confirmation links, never read from a request header.
    "PUBLIC_ORIGIN": "http://localhost:4173"
  }
  // cairn-template:exclude-start
  //
  // Declares the one Worker secret the engine cannot run without: the GitHub App's private key
  // (src/lib/env.ts's GITHUB_APP_PRIVATE_KEY_B64, `wrangler secret put GITHUB_APP_PRIVATE_KEY_B64`).
  // With this declared, `wrangler deploy` refuses to ship an existing Worker that is missing it,
  // rather than deploying a build no editor can ever publish through. AUTH_DB, EMAIL, and
  // PUBLIC_ORIGIN above are bindings and vars, not secrets, so they stay out of this list; the
  // optional ANTHROPIC_API_KEY (Tidy) stays out too, since the schema has no "optional" entry and
  // declaring it required would fail a deploy that simply never opted into Tidy.
  //
  // Excluded from create-cairn-site's own baked template (scripts/build/emit-template.mjs's
  // marker strip removes this whole block): the scaffolder's automated chapter deploys a
  // brand-new Worker to learn its workers.dev URL before it has anywhere to push the App's key,
  // and wrangler refuses the very first deploy of a Worker that does not exist yet when a
  // required secret is unset (there is no earlier version to inherit it from). A showcase deploy,
  // and every doc-guided manual site (docs/extend/add-cairn-to-a-sveltekit-app.md, docs/extend/build-a-site-by-hand.md),
  // always sets this secret on an already-existing Worker before its next `wrangler deploy`, so
  // the declaration holds there.
  //
  // Declaring "secrets" also changes local dev: wrangler 4.125 sets includeProcessEnv whenever
  // "secrets" is present, so `wrangler dev` reads the required secret's value from the ambient
  // shell environment when no `.dev.vars` file exists, rather than refusing to start. Keep a
  // `.dev.vars` present in this directory for local dev (the showcase carries no
  // `.dev.vars.example`; see docs/extend/add-cairn-to-a-sveltekit-app.md for the values it needs).
  ,
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY_B64"]
  }
  // cairn-template:exclude-end
}
