// An on-demand dead-code instrument, not a gate. Run it by hand (`npx knip@6.23.0
// --no-progress`) when auditing for unused exports or dependencies; nothing in CI depends on it.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "cloudflare"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "src/tests/unit/**/*.test.ts",
        "src/tests/integration/**/*.test.ts",
        "src/tests/component/**/*.test.ts"
      ],
      "project": [
        "src/lib/**/*.{ts,svelte}",
        "src/tests/**/*.ts",
        "scripts/**/*.mjs"
      ]
    },
    "packages/cairn-cms-dev": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/showcase": {
      "sveltekit": true,
      "entry": [
        "e2e/**/*.spec.ts",
        "src/routes/test/**/+server.ts"
      ],
      "project": ["src/**/*.{ts,svelte}", "e2e/**/*.ts"]
    }
  }
}
