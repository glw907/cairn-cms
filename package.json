{
  "name": "@glw907/cairn-cms",
  "version": "0.99.0-rc.2",
  "description": "Embedded, magic-link, GitHub-committing CMS for SvelteKit/Cloudflare sites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "**/*.svelte",
    "**/*.css",
    "dist/*/browser.js"
  ],
  "license": "MIT",
  "author": "Geoff Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glw907/cairn-cms.git"
  },
  "homepage": "https://github.com/glw907/cairn-cms#readme",
  "bugs": {
    "url": "https://github.com/glw907/cairn-cms/issues"
  },
  "keywords": [
    "cms",
    "sveltekit",
    "cloudflare",
    "github",
    "magic-link",
    "markdown"
  ],
  "scripts": {
    "package": "svelte-package && node scripts/build/build-admin-css.mjs && node scripts/build/transpile-dist-svelte.mjs && chmod +x dist/vite/bin.js dist/audit/bin.js dist/guidance/bin.js && tsc -p packages/cairn-cms-dev/tsconfig.build.json && chmod +x packages/cairn-cms-dev/dist/media-seed/bin.js",
    "check:package": "npm run package && publint --strict && T=$(mktemp -d) && trap 'rm -rf \"$T\"' EXIT && npm pack --ignore-scripts --silent --pack-destination \"$T\" && attw \"$T\"/*.tgz --ignore-rules no-resolution cjs-resolves-to-esm internal-resolution-error && node scripts/checks/check-package-files.mjs && node scripts/checks/check-skill-budget.mjs",
    "check:audit-pack": "npm run package && node scripts/checks/check-audit-pack.mjs",
    "check:options": "npm run package && node scripts/checks/check-options.mjs",
    "check:tiers": "npm run package && node scripts/checks/check-tiers.mjs",
    "check:surface": "npm run package && node scripts/checks/check-surface-leaks.mjs && node scripts/checks/check-surface.mjs",
    "check:self-use": "npm run package && node scripts/checks/check-self-use.mjs",
    "check:readiness": "npm run package && node scripts/checks/check-readiness.mjs",
    "check:tool-conditions": "npm run package && node scripts/checks/check-tool-conditions.mjs",
    "check:tool-heuristics": "node scripts/checks/check-tool-heuristics.mjs",
    "check:docs": "node scripts/checks/docs-links.mjs",
    "check:rulings-format": "node scripts/checks/check-rulings-format.mjs",
    "check:consumers-must": "node scripts/checks/check-consumers-must.mjs",
    "check:symbols": "node scripts/checks/check-symbols.mjs",
    "check:vale": "vale --minAlertLevel=error docs README.md examples/showcase/README.md",
    "check:editor-quotes": "node scripts/checks/check-editor-quotes.mjs",
    "check:leaks": "node scripts/checks/check-leaks.mjs",
    "check:docs-gate": "node scripts/checks/docs-gate.mjs",
    "check:visuals": "npm run package && node scripts/checks/check-visuals.mjs",
    "check:transcripts": "node scripts/checks/transcript-blocks.mjs",
    "check:snippets": "npm run package && node scripts/checks/check-snippets.mjs",
    "check:version": "node scripts/checks/check-version.mjs",
    "check:prose": "node scripts/checks/check-admin-prose.mjs",
    "check:public-tokens": "npm run package && node scripts/checks/check-public-scope.mjs",
    "check:public-skill": "npm run package && node scripts/checks/check-public-skill.mjs",
    "check:custom-surface": "npm run package && node scripts/checks/check-custom-surface.mjs",
    "check:chassis-boundary": "node scripts/checks/check-chassis-boundary.mjs",
    "check:cm-internals": "node scripts/checks/check-cm-internals.mjs",
    "check:idioms": "node scripts/checks/check-idioms.mjs",
    "check:invisible-craft": "npm run package && node scripts/checks/check-invisible-craft.mjs",
    "check:admin-css-classes": "npm run package && node scripts/checks/check-admin-css-classes.mjs",
    "update-admin-sheet-inventory": "npm run package && node scripts/build/update-admin-sheet-inventory.mjs",
    "test:reskin": "npm run package && node scripts/lab/reskin-fixture.mjs",
    "test:theme-fixture": "npm run package && node scripts/lab/theme-fixture.mjs",
    "lint": "eslint src/lib examples/showcase/src examples/showcase/e2e scripts/checks/close-prebuilt.mjs scripts/checks/gate-tier.mjs scripts/checks/fast-lane.mjs scripts/ci/retries-notice.mjs scripts/ci/vitest-retry-reporter.mjs",
    "check:comments": "bash scripts/checks/check-comments.sh",
    "check:dev-package": "node scripts/checks/check-dev-package.mjs",
    "check:consumers": "npm run package && node scripts/checks/check-consumers.mjs",
    "prepare": "npm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p src/tests/types/tsconfig.json",
    "check:close": "node scripts/checks/close-prebuilt.mjs",
    "lane:fast": "node scripts/checks/fast-lane.mjs",
    "test:node-projects": "vitest run --project unit --project unit-dist-spawn --project integration",
    "test": "npm run test:node-projects && npm run test:component",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "node scripts/test/contained.mjs vitest run --project component",
    "emit-template": "node scripts/build/emit-template.mjs",
    "test:emit": "node --test scripts/build/emit-template.test.mjs .claude/skills/cairn-writing-docs/evals/run.test.mjs .claude/skills/cairn-writing-docs/evals/run-site.test.mjs",
    "design:mockup-css": "npm run package && node scripts/build/build-mockup-css.mjs",
    "emit:template": "node packages/create-cairn-site/scripts/emit-template-dir.mjs",
    "check:template": "node packages/create-cairn-site/scripts/emit-template-dir.mjs --check",
    "link:consumer": "node scripts/lab/link-consumer.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "svelte": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "svelte": "./dist/public/index.js",
      "default": "./dist/public/index.js"
    },
    "./admin-toolkit": {
      "types": "./dist/admin-toolkit/index.d.ts",
      "svelte": "./dist/admin-toolkit/index.js",
      "default": "./dist/admin-toolkit/index.js"
    },
    "./islands": {
      "types": "./dist/islands/index.d.ts",
      "default": "./dist/islands/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "svelte": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "svelte": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./reproductions": {
      "types": "./dist/reproductions/index.d.ts",
      "svelte": "./dist/reproductions/index.js",
      "default": "./dist/reproductions/index.js"
    },
    "./reproductions/manifest": {
      "types": "./dist/reproductions/manifest.d.ts",
      "default": "./dist/reproductions/manifest.js"
    },
    "./auth-crypto": {
      "types": "./dist/auth-crypto/index.d.ts",
      "worker": "./dist/auth-crypto/index.js",
      "browser": "./dist/auth-crypto/browser.js",
      "default": "./dist/auth-crypto/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "worker": "./dist/cloudflare/index.js",
      "browser": "./dist/cloudflare/browser.js",
      "default": "./dist/cloudflare/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts",
      "default": "./dist/ambient.js"
    },
    "./log": {
      "types": "./dist/log/public.d.ts",
      "default": "./dist/log/public.js"
    },
    "./admin-sources.css": "./dist/admin-sources.css",
    "./cairn-public.css": "./dist/public/cairn-public.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "cairn-manifest": "dist/vite/bin.js",
    "cairn-audit": "dist/audit/bin.js",
    "cairn-guidance": "dist/guidance/bin.js"
  },
  "files": [
    "dist",
    "migrations",
    "schema",
    "skills",
    "claude",
    "guidance-hashes.json",
    "scripts/checks/api-surface.md",
    "CHANGELOG.md",
    "MIGRATION-NOTES.md",
    "docs/why-cairn.md",
    "docs/architecture.md",
    "docs/admin",
    "docs/editors"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.105.0 <1",
    "@cloudflare/workers-types": "^5",
    "@sveltejs/kit": "^3",
    "daisyui": "^5",
    "svelte": "^5.57.1",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "daisyui": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.66.0",
    "@rodrigodagostino/svelte-sortable-list": "^2.2.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "culori": "^4.0.2",
    "esm-env": "^1.2.2",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.3",
    "heic-to": "^1.6.7",
    "mdast-util-directive": "^3.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.6.0",
    "spellchecker-wasm": "^0.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "daisyui": "^5.7.50",
    "devalue": "^5.9.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.148.0"
  }
}
