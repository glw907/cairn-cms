{
  "name": "@glw907/cairn-cms",
  "version": "0.99.0-rc.4",
  "description": "Embedded, magic-link, GitHub-committing CMS for SvelteKit/Cloudflare sites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "**/*.svelte",
    "**/*.css",
    "dist/*/browser.js"
  ],
  "license": "MIT",
  "author": "Geoff Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glw907/cairn-cms.git"
  },
  "homepage": "https://github.com/glw907/cairn-cms#readme",
  "bugs": {
    "url": "https://github.com/glw907/cairn-cms/issues"
  },
  "keywords": [
    "cms",
    "sveltekit",
    "cloudflare",
    "github",
    "magic-link",
    "markdown"
  ],
  "scripts": {
    "package": "svelte-package && node scripts/build/build-admin-css.mjs && node scripts/build/transpile-dist-svelte.mjs && chmod +x dist/vite/bin.js dist/audit/bin.js dist/guidance/bin.js && tsc -p packages/cairn-cms-dev/tsconfig.build.json && chmod +x packages/cairn-cms-dev/dist/media-seed/bin.js",
    "check:package": "node scripts/checks/run.mjs check:package",
    "check:audit-pack": "node scripts/checks/run.mjs check:audit-pack",
    "check:options": "node scripts/checks/run.mjs check:options",
    "check:tiers": "node scripts/checks/run.mjs check:tiers",
    "check:surface": "node scripts/checks/run.mjs check:surface",
    "check:self-use": "node scripts/checks/run.mjs check:self-use",
    "check:readiness": "node scripts/checks/run.mjs check:readiness",
    "check:docs": "node scripts/checks/run.mjs check:docs",
    "check:rulings-format": "node scripts/checks/run.mjs check:rulings-format",
    "check:consumers-must": "node scripts/checks/run.mjs check:consumers-must",
    "check:symbols": "node scripts/checks/run.mjs check:symbols",
    "check:vale": "node scripts/checks/run.mjs check:vale",
    "check:editor-quotes": "node scripts/checks/run.mjs check:editor-quotes",
    "check:leaks": "node scripts/checks/run.mjs check:leaks",
    "check:docs-gate": "node scripts/checks/run.mjs docs-gate",
    "check:visuals": "node scripts/checks/run.mjs check:visuals",
    "check:snippets": "node scripts/checks/run.mjs check:snippets",
    "check:version": "node scripts/checks/run.mjs check:version",
    "check:prose": "node scripts/checks/run.mjs check:prose",
    "check:public-tokens": "node scripts/checks/run.mjs check:public-tokens",
    "check:public-skill": "node scripts/checks/run.mjs check:public-skill",
    "check:custom-surface": "node scripts/checks/run.mjs check:custom-surface",
    "check:chassis-boundary": "node scripts/checks/run.mjs check:chassis-boundary",
    "check:cm-internals": "node scripts/checks/run.mjs check:cm-internals",
    "check:idioms": "node scripts/checks/run.mjs check:idioms",
    "check:invisible-craft": "node scripts/checks/run.mjs check:invisible-craft",
    "check:admin-css-classes": "node scripts/checks/run.mjs check:admin-css-classes",
    "update-admin-sheet-inventory": "npm run package && node scripts/build/update-admin-sheet-inventory.mjs",
    "test:reskin": "npm run package && node scripts/lab/reskin-fixture.mjs",
    "test:theme-fixture": "npm run package && node scripts/lab/theme-fixture.mjs",
    "lint": "eslint src/lib examples/showcase/src examples/showcase/e2e scripts/checks/close-prebuilt.mjs scripts/checks/gate-tier.mjs scripts/checks/registry.mjs scripts/checks/run.mjs scripts/checks/fast-lane.mjs scripts/ci/retries-notice.mjs scripts/ci/vitest-retry-reporter.mjs",
    "check:comments": "node scripts/checks/run.mjs check:comments",
    "check:dev-package": "node scripts/checks/run.mjs check:dev-package",
    "check:consumers": "node scripts/checks/run.mjs check:consumers",
    "prepare": "npm run package && npm run theme:lay-in",
    "theme:view": "node scripts/theme/viewer.mjs",
    "theme:lay-in": "node scripts/theme/lay-in.mjs themes/waymark examples/showcase",
    "check": "node scripts/checks/run.mjs check",
    "check:close": "node scripts/checks/run.mjs close",
    "lane:fast": "node scripts/checks/fast-lane.mjs",
    "test:node-projects": "vitest run --project unit --project unit-dist-spawn --project integration",
    "test": "npm run test:node-projects && npm run test:component",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "node scripts/test/contained.mjs vitest run --project component",
    "emit-template": "node scripts/build/emit-template.mjs",
    "test:catalog": "node scripts/checks/run.mjs test:catalog",
    "test:theme": "node scripts/checks/run.mjs test:theme",
    "check:theme": "node scripts/checks/run.mjs check:theme",
    "test:emit": "node scripts/checks/run.mjs test:emit",
    "design:mockup-css": "npm run package && node scripts/build/build-mockup-css.mjs",
    "emit:template": "node scripts/build/emit-template-dir.mjs",
    "check:template": "node scripts/checks/run.mjs check:template",
    "check:definitions": "node scripts/checks/run.mjs check:definitions",
    "check:showcase-types": "node scripts/checks/run.mjs check:showcase-types",
    "check:showcase-cairn": "node scripts/checks/run.mjs check:showcase-cairn",
    "check:showcase-format": "node scripts/checks/run.mjs check:showcase-format",
    "check:showcase-unit": "node scripts/checks/run.mjs check:showcase-unit",
    "check:version-rise": "node scripts/checks/run.mjs check:version-rise",
    "check:site-record-page": "node scripts/checks/run.mjs check:site-record-page",
    "check:tellgrader": "node scripts/checks/run.mjs check:tellgrader",
    "check:vale-rules": "node scripts/checks/run.mjs check:vale-rules",
    "link:consumer": "node scripts/lab/link-consumer.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "svelte": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "svelte": "./dist/public/index.js",
      "default": "./dist/public/index.js"
    },
    "./admin-toolkit": {
      "types": "./dist/admin-toolkit/index.d.ts",
      "svelte": "./dist/admin-toolkit/index.js",
      "default": "./dist/admin-toolkit/index.js"
    },
    "./islands": {
      "types": "./dist/islands/index.d.ts",
      "default": "./dist/islands/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "svelte": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "svelte": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./reproductions": {
      "types": "./dist/reproductions/index.d.ts",
      "svelte": "./dist/reproductions/index.js",
      "default": "./dist/reproductions/index.js"
    },
    "./reproductions/manifest": {
      "types": "./dist/reproductions/manifest.d.ts",
      "default": "./dist/reproductions/manifest.js"
    },
    "./auth-crypto": {
      "types": "./dist/auth-crypto/index.d.ts",
      "worker": "./dist/auth-crypto/index.js",
      "browser": "./dist/auth-crypto/browser.js",
      "default": "./dist/auth-crypto/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "worker": "./dist/cloudflare/index.js",
      "browser": "./dist/cloudflare/browser.js",
      "default": "./dist/cloudflare/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts",
      "default": "./dist/ambient.js"
    },
    "./log": {
      "types": "./dist/log/public.d.ts",
      "default": "./dist/log/public.js"
    },
    "./admin-sources.css": "./dist/admin-sources.css",
    "./cairn-public.css": "./dist/public/cairn-public.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "cairn-manifest": "dist/vite/bin.js",
    "cairn-audit": "dist/audit/bin.js",
    "cairn-guidance": "dist/guidance/bin.js"
  },
  "files": [
    "dist",
    "migrations",
    "schema",
    "skills",
    "claude",
    "template",
    "guidance-hashes.json",
    "scripts/checks/api-surface.md",
    "CHANGELOG.md",
    "MIGRATION-NOTES.md",
    "docs/why-cairn.md",
    "docs/architecture.md",
    "docs/admin",
    "docs/editors"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.105.0 <1",
    "@cloudflare/workers-types": "^5",
    "@sveltejs/kit": "^3",
    "daisyui": "^5",
    "svelte": "^5.57.1",
    "tailwindcss": "^4"
  },
