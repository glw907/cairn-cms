    "lightningcss": "^1.33.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postcss-prefix-selector": "^2.2.1",
    "publint": "^0.3.25",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "4.3.5",
