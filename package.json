{
  "name": "@glw907/cairn-cms",
  "version": "0.95.0",
  "description": "Embedded, magic-link, GitHub-committing CMS for SvelteKit/Cloudflare sites.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "**/*.svelte",
    "**/*.css",
    "dist/*/browser.js"
  ],
  "license": "MIT",
  "author": "Geoff Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glw907/cairn-cms.git"
  },
  "homepage": "https://github.com/glw907/cairn-cms#readme",
  "bugs": {
    "url": "https://github.com/glw907/cairn-cms/issues"
  },
  "keywords": [
    "cms",
    "sveltekit",
    "cloudflare",
    "github",
    "magic-link",
    "markdown"
  ],
  "scripts": {
    "package": "svelte-package && node scripts/build/build-admin-css.mjs && node scripts/build/transpile-dist-svelte.mjs && chmod +x dist/vite/bin.js dist/doctor/bin.js dist/media-seed/bin.js dist/audit/bin.js",
    "check:package": "npm run package && publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm internal-resolution-error && node scripts/checks/check-package-files.mjs && node scripts/checks/check-skill-budget.mjs",
    "check:reference": "npm run package && node scripts/checks/reference-coverage.mjs",
    "check:reference:signatures": "npm run package && node scripts/checks/check-reference-signatures.mjs",
    "check:surface": "npm run package && node scripts/checks/check-surface.mjs",
    "check:readiness": "npm run package && node scripts/checks/check-readiness.mjs",
    "check:docs": "node scripts/checks/docs-links.mjs",
    "check:target-stack": "node scripts/checks/check-target-stack.mjs",
    "check:symbols": "node scripts/checks/check-symbols.mjs",
    "check:vale": "vale --minAlertLevel=error docs README.md examples/showcase/README.md",
    "check:arm-indexes": "node scripts/checks/check-arm-indexes.mjs",
    "check:visuals": "npm run package && node scripts/checks/check-visuals.mjs",
    "check:transcripts": "node scripts/checks/transcript-blocks.mjs",
    "check:snippets": "npm run package && node scripts/checks/check-snippets.mjs",
    "check:version": "node scripts/checks/check-version.mjs",
    "check:prose": "node scripts/checks/check-admin-prose.mjs",
    "check:public-tokens": "node scripts/checks/check-public-tokens.mjs",
    "check:custom-surface": "npm run package && node scripts/checks/check-custom-surface.mjs",
    "check:chassis-boundary": "node scripts/checks/check-chassis-boundary.mjs",
    "check:cm-internals": "node scripts/checks/check-cm-internals.mjs",
    "check:invisible-craft": "npm run package && node scripts/checks/check-invisible-craft.mjs",
    "check:admin-css-classes": "npm run package && node scripts/checks/check-admin-css-classes.mjs",
    "update-admin-sheet-inventory": "npm run package && node scripts/build/update-admin-sheet-inventory.mjs",
    "check:interactive-contrast": "node scripts/checks/check-interactive-contrast.mjs",
    "check:touch-targets": "node scripts/checks/check-touch-targets.mjs",
    "test:reskin": "node scripts/lab/reskin-fixture.mjs",
    "norms:generate": "npm run package && node scripts/lab/generate-norms-manifest.mjs",
    "norms:check": "npm run package && node scripts/lab/generate-norms-manifest.mjs --check",
    "lint": "eslint src/lib",
    "check:comments": "bash scripts/checks/check-comments.sh",
    "check:dev-package": "node scripts/checks/check-dev-package.mjs",
    "check:consumers": "npm run package && node scripts/checks/check-consumers.mjs",
    "prepare": "npm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "emit-template": "node scripts/build/emit-template.mjs",
    "test:emit": "node --test scripts/build/emit-template.test.mjs",
    "design:mockup-css": "npm run package && node scripts/build/build-mockup-css.mjs",
    "emit:template": "node packages/create-cairn-site/scripts/emit-template-dir.mjs",
    "check:template": "node packages/create-cairn-site/scripts/emit-template-dir.mjs --check",
    "link:consumer": "node scripts/lab/link-consumer.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./admin-toolkit": {
      "types": "./dist/admin-toolkit/index.d.ts",
      "svelte": "./dist/admin-toolkit/index.js",
      "default": "./dist/admin-toolkit/index.js"
    },
    "./islands": {
      "types": "./dist/islands/index.d.ts",
      "default": "./dist/islands/index.js"
    },
    "./render": {
      "types": "./dist/render/authoring.d.ts",
      "svelte": "./dist/render/authoring.js",
      "default": "./dist/render/authoring.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "svelte": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    },
    "./delivery/head": {
      "types": "./dist/delivery/head.d.ts",
      "svelte": "./dist/delivery/head.js",
      "default": "./dist/delivery/head.js"
    },
    "./delivery/data": {
      "types": "./dist/delivery/data.d.ts",
      "svelte": "./dist/delivery/data.js",
      "default": "./dist/delivery/data.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "svelte": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./reproductions": {
      "types": "./dist/reproductions/index.d.ts",
      "svelte": "./dist/reproductions/index.js",
      "default": "./dist/reproductions/index.js"
    },
    "./reproductions/manifest": {
      "types": "./dist/reproductions/manifest.d.ts",
      "default": "./dist/reproductions/manifest.js"
    },
    "./auth-store": {
      "types": "./dist/auth-store/index.d.ts",
      "default": "./dist/auth-store/index.js"
    },
    "./auth-channel": {
      "types": "./dist/auth-channel/index.d.ts",
      "default": "./dist/auth-channel/index.js"
    },
    "./auth-crypto": {
      "types": "./dist/auth-crypto/index.d.ts",
      "worker": "./dist/auth-crypto/index.js",
      "browser": "./dist/auth-crypto/browser.js",
      "default": "./dist/auth-crypto/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "worker": "./dist/cloudflare/index.js",
      "browser": "./dist/cloudflare/browser.js",
      "default": "./dist/cloudflare/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts",
      "default": "./dist/ambient.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cairn-manifest": "./dist/vite/bin.js",
    "cairn-doctor": "./dist/doctor/bin.js",
    "cairn-media-seed": "./dist/media-seed/bin.js",
    "cairn-audit": "./dist/audit/bin.js"
  },
  "files": [
    "dist",
    "migrations",
    "skills",
    "CHANGELOG.md",
    "docs/README.md",
    "docs/why-cairn.md",
    "docs/reference",
    "docs/admin",
    "docs/editors",
    "docs/extend"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.105.0 <1",
    "@cloudflare/workers-types": "^5",
    "@sveltejs/kit": "^2.70",
    "svelte": "^5.56.10"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.17.0",
    "@rodrigodagostino/svelte-sortable-list": "^2.1.17",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "esm-env": "^1.2.2",
    "gray-matter": "^4",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "heic-to": "^1.5.2",
    "mdast-util-directive": "^3.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.3.0",
    "spellchecker-wasm": "^0.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@arethetypeswrong/cli": "^0.18.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@sveltejs/kit": "^2.70",
    "@sveltejs/package": "^2",
    "@sveltejs/vite-plugin-svelte": "^7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "culori": "^4.0.2",
    "daisyui": "^5.6.6",
    "devalue": "^5.8.1",
    "eslint": "^10.9.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "lightningcss": "^1.32.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "postcss-prefix-selector": "^2.1.1",
    "publint": "^0.3.21",
    "svelte": "^5.56.10",
    "svelte-check": "^4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0",
    "vitest": "^4.1",
    "vitest-browser-svelte": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}
