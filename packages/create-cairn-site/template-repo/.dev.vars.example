# Local-only secrets for cairn-cms. Copy this file to .dev.vars (gitignored) and fill in real
# values; never commit a real value here.

# The GitHub App's private key, base64-encoded. The App id and installation id are not secrets;
# they live in the adapter. The App's key must parse and sign, and its installation must mint a
# token and read this site's repository. See the cairn-cms "set up the GitHub App" guide.
GITHUB_APP_PRIVATE_KEY_B64 = "base64-encoded-pem-placeholder"

# Optional: only read when tidy is enabled in site.config.yaml.
ANTHROPIC_API_KEY = ""
