{
  "buckets": {
    "docs": [
      "docs/",
      "*.md",
      "**/*.md",
      ".vale/",
      ".vale.ini",
      ".tellgrader.json",
      "skills/",
      "claude/"
    ],
    "scripts": [
      "scripts/",
      "src/tests/",
      ".github/",
      "eslint.config.js",
      "tsdoc.json",
      "vitest.config.ts",
      "wrangler.test.jsonc"
    ],
    "harness": [".claude/"],
    "showcase": ["examples/showcase/", "themes/", "templates/", "sets/", "definitions/"],
    "theme": ["scripts/theme/"],
    "plugins": ["plugins/"],
    "engine": [
      "src/lib/",
      "scripts/build/",
      "packages/cairn-cms-dev/",
      "migrations/",
      "package.json",
      "package-lock.json",
      "svelte.config.js",
      "tsconfig.json"
    ],
    "exportSurface": [
      "src/lib/**/index.ts",
      "package.json",
      "scripts/checks/check-surface-leaks.json",
      "scripts/checks/check-self-use-allowlist.json",
      "scripts/checks/check-symbols-allowlist.mjs",
      "scripts/checks/api-surface.md",
      "schema/",
      "skills/",
      "claude/"
    ]
  },
  "noCheck": [".gitattributes", "knip.jsonc"],
  "unitSelectable": [
    "src/",
    "docs/",
    "BACKLOG.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MIGRATION-NOTES.md",
    "README.md",
    "ROADMAP.md",
    ".vale/",
    ".vale.ini",
    ".tellgrader.json"
  ],
  "scriptsTestOnly": [
    "scripts/catalog/",
    "scripts/ci/",
    "scripts/test/",
    "scripts/checks/gate-table.json",
    "scripts/checks/gate-tier.mjs"
  ],
  "e2e": {
    "floor": {
      "prefixes": ["src/lib/admin/", "src/lib/admin-toolkit/"],
      "specs": ["admin-visual.spec.ts"]
    },
    "unmappedLib": ["golden-path.spec.ts", "access-map.spec.ts", "csrf-origin.spec.ts"],
    "authData": ["golden-path.spec.ts", "access-map.spec.ts", "csrf-origin.spec.ts"],
    "paint": ["admin-visual.spec.ts"],
    "map": [
      {
        "prefixes": ["src/lib/admin/"],
        "specs": [
          "golden-path.spec.ts",
          "admin-error-page.spec.ts",
          "edit-save-failure.spec.ts",
          "refused-forms.spec.ts",
          "keyboard-walk.spec.ts",
          "admin-shell-sidebar.spec.ts",
          "admin-nav-layout.spec.ts",
          "nav-menus.spec.ts",
          "admin-referrer.spec.ts",
          "admin-sheet.spec.ts",
          "theme-kit.spec.ts",
          "cards-admin.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/admin-toolkit/"],
        "specs": [
          "custom-screen.spec.ts",
          "theme-kit.spec.ts",
          "theme-kit-contrast.spec.ts",
          "vocabulary-admin.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/render/"],
        "specs": [
          "site-visual.spec.ts",
          "prose-flow-rhythm.spec.ts",
          "prose-table.spec.ts",
          "reading-surface-edge-cases.spec.ts",
          "markdown-twin.spec.ts",
          "islands.spec.ts",
          "fragments.spec.ts",
          "styleguide.spec.ts",
          "public-theme-equivalence.spec.ts",
          "preview.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/public/"],
        "specs": [
          "site-visual.spec.ts",
          "preview.spec.ts",
          "public-preview-tokens.spec.ts",
          "styleguide.spec.ts",
          "islands.spec.ts",
          "public-theme-equivalence.spec.ts"
        ]
      },
      { "prefixes": ["src/lib/islands/"], "specs": ["islands.spec.ts", "styleguide.spec.ts"] },
      {
        "prefixes": ["src/lib/delivery/"],
        "specs": [
          "markdown-twin.spec.ts",
          "tag-filter.spec.ts",
          "nav-from-config.spec.ts",
          "fragments.spec.ts",
          "site-visual.spec.ts",
          "preview.spec.ts",
          "healthz.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/media/"],
        "specs": [
          "media-figure.spec.ts",
          "media-hero.spec.ts",
          "media-insert.spec.ts",
          "media-library.spec.ts",
          "media-pass-b.spec.ts",
          "media-pass-c.spec.ts",
          "media-slice.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/design/"],
        "specs": [
          "theme-kit.spec.ts",
          "theme-kit-contrast.spec.ts",
          "admin-sheet.spec.ts",
          "public-theme-equivalence.spec.ts",
          "starter-outline-pin.spec.ts",
          "styleguide.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/nav/"],
        "specs": ["admin-nav-layout.spec.ts", "nav-from-config.spec.ts", "nav-menus.spec.ts"]
      },
      { "prefixes": ["src/lib/guidance/"], "specs": ["tidy.spec.ts", "spellcheck.spec.ts"] },
      {
        "prefixes": ["src/lib/github/"],
        "specs": [
          "golden-path.spec.ts",
          "edit-save-failure.spec.ts",
          "publish-pending-word.spec.ts",
          "container-fields.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/content/"],
        "specs": [
          "golden-path.spec.ts",
          "container-fields.spec.ts",
          "vocabulary-admin.spec.ts",
          "fragments.spec.ts",
          "tag-filter.spec.ts",
          "publish-pending-word.spec.ts",
          "edit-save-failure.spec.ts"
        ]
      },
      {
        "prefixes": ["src/lib/sveltekit/"],
        "specs": [
          "golden-path.spec.ts",
          "access-map.spec.ts",
          "csrf-origin.spec.ts",
          "keyboard-walk.spec.ts",
          "custom-screen.spec.ts",
          "section-refusals.spec.ts",
          "edit-save-failure.spec.ts",
          "publish-pending-word.spec.ts",
          "healthz.spec.ts",
          "admin-referrer.spec.ts",
          "preview.spec.ts"
        ]
      },
      { "prefixes": ["src/lib/diagnostics/"], "specs": ["healthz.spec.ts", "golden-path.spec.ts"] },
      { "prefixes": ["scripts/gate/browser.mjs"], "specs": ["gate-publish.spec.ts"] },
      {
        "prefixes": [
          "examples/showcase/src/routes/(site)/",
          "examples/showcase/src/chassis/",
          "examples/showcase/src/theme/",
          "themes/"
        ],
        "specs": [
          "site-visual.spec.ts",
          "masthead-responsive.spec.ts",
          "nav-from-config.spec.ts",
          "prose-flow-rhythm.spec.ts",
          "prose-table.spec.ts",
          "reading-surface-edge-cases.spec.ts",
          "theme-toggle.spec.ts",
          "chassis-roles.spec.ts",
          "tag-filter.spec.ts",
          "styleguide.spec.ts",
          "islands.spec.ts",
          "markdown-twin.spec.ts",
          "preview.spec.ts",
          "public-preview-tokens.spec.ts",
          "starter-outline-pin.spec.ts",
          "public-theme-equivalence.spec.ts",
          "fragments.spec.ts",
          "cards.spec.ts",
          "cards-admin.spec.ts"
        ]
      },
      {
        "prefixes": ["examples/showcase/src/routes/admin/"],
        "specs": [
          "admin-visual.spec.ts",
          "admin-error-page.spec.ts",
          "custom-screen.spec.ts",
          "section-refusals.spec.ts",
          "theme-kit.spec.ts",
          "theme-kit-contrast.spec.ts",
          "vocabulary-admin.spec.ts",
          "golden-path.spec.ts"
        ]
      },
      {
        "prefixes": ["examples/showcase/src/content/"],
        "specs": [
          "golden-path.spec.ts",
          "site-visual.spec.ts",
          "tag-filter.spec.ts",
          "markdown-twin.spec.ts",
          "preview.spec.ts",
          "fragments.spec.ts"
        ]
      }
    ]
  },
  "protected": [
    "scripts/checks/gate-table.json",
    "scripts/checks/gate-tier.mjs",
    "scripts/test/component-rerun-triggers.mjs",
    ".github/ci-green.json",
    ".github/workflows/"
  ]
}
