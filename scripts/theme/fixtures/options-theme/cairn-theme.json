{
  "$schema": "https://cairn.pub/schemas/cairn-theme/1.json",
  "id": "options-theme",
  "name": "Options theme",
  "description": "A fixture theme with one accent option.",
  "version": "1.0.0",
  "license": "MIT",
  "author": { "name": "cairn", "url": "https://cairn.pub" },
  "contract": 1,
  "colorModes": { "light": "opts", "dark": "opts-dark" },
  "options": [
    {
      "key": "accent",
      "label": "Accent",
      "values": [
        { "value": "ember", "label": "Ember" },
        { "value": "tide", "label": "Tide" }
      ],
      "default": "ember"
    }
  ],
  "fonts": [
    {
      "name": "Source Code Pro",
      "license": "OFL-1.1",
      "source": "https://fontsource.org/fonts/source-code-pro",
      "files": ["fonts/source-code-pro-greek-ext-wght-normal.woff2"]
    }
  ],
  "screenshots": []
}
