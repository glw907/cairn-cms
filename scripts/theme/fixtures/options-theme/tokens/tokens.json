{
  "$description": "The fixture theme's tokens. Each token key is the CSS custom property name without its leading dashes.",
  "base": {
    "$description": "Waymark's shared values, apart from the body face, the step-0 clamp, two em spaces, and a vw measure, which exercise the untyped string forms.",
    "font-display": { "$type": "fontFamily", "$value": ["Figtree Variable", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "font-body": { "$type": "fontFamily", "$value": ["Georgia", "serif"] },
    "font-mono": { "$type": "fontFamily", "$value": ["Source Code Pro Variable", "ui-monospace", "SF Mono", "Menlo", "monospace"] },
    "text-step--2": { "$value": "clamp(0.72rem, 0.7rem + 0.05vw, 0.76rem)" },
    "text-step--1": { "$type": "dimension", "$value": { "value": 0.84, "unit": "rem" } },
    "text-step-0": { "$value": "clamp(1rem, 0.95rem + 0.2vw, 1.1rem)" },
    "text-step-1": { "$value": "clamp(1.27rem, 1.25rem + 0.1vw, 1.33rem)" },
    "text-step-2": { "$value": "clamp(1.27rem, 1.25rem + 0.1vw, 1.33rem)" },
    "text-step-3": { "$value": "clamp(1.52rem, 1.47rem + 0.24vw, 1.66rem)" },
    "text-step-4": { "$value": "clamp(1.83rem, 1.74rem + 0.43vw, 2.08rem)" },
    "text-step-5": { "$value": "clamp(2.19rem, 2.05rem + 0.71vw, 2.6rem)" },
    "spacing-3xs": { "$value": "clamp(0.31rem, 0.3rem + 0.05vw, 0.34rem)" },
    "spacing-2xs": { "$value": "clamp(0.5rem, 0.48rem + 0.11vw, 0.56rem)" },
    "spacing-xs": { "$value": "clamp(0.75rem, 0.72rem + 0.16vw, 0.84rem)" },
    "spacing-s": { "$value": "1em" },
    "spacing-m": { "$value": "1.5em" },
    "spacing-l": { "$value": "clamp(2rem, 1.91rem + 0.43vw, 2.25rem)" },
    "spacing-xl": { "$value": "clamp(3rem, 2.83rem + 0.87vw, 3.5rem)" },
    "spacing-2xl": { "$value": "clamp(4rem, 3.74rem + 1.3vw, 4.75rem)" },
    "leading-body": { "$type": "number", "$value": 1.65 },
    "leading-snug": { "$type": "number", "$value": 1.4 },
    "leading-tight": { "$type": "number", "$value": 1.12 },
    "tracking-tight": { "$value": "-0.011em" },
    "tracking-eyebrow": { "$value": "0.12em" },
    "container-measure": { "$value": "60vw" },
    "container-measure-wide": { "$type": "dimension", "$value": { "value": 58, "unit": "rem" } },
    "color-card-border": { "$value": "color-mix(in oklab, var(--color-base-content) 9%, transparent)" },
    "cairn-caption-tracking": { "$value": "0.09em" },
    "cairn-eyebrow-case": { "$value": "uppercase" },
    "cairn-scroll-cue": { "$value": "linear-gradient(to right, transparent, var(--cairn-code-bg) 85%), radial-gradient(farthest-side at 100% 50%, color-mix(in oklab, var(--color-base-content) 22%, transparent), transparent)" }
  },
