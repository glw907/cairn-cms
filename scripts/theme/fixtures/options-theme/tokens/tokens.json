      "cairn-warning-ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 76] } },
      "cairn-error-ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.76, 0.14, 27] } },
      "cairn-info-ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.8, 0.1, 235] } },
      "radius-selector": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "radius-field": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
      "radius-box": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "size-selector": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "size-field": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "border": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "depth": { "$type": "number", "$value": 0 },
      "noise": { "$type": "number", "$value": 0 },
      "color-card-border": { "$value": "color-mix(in oklab, var(--color-base-content) 16%, transparent)" },
      "cairn-shadow": { "$value": "0 1px 2px color-mix(in oklab, black 40%, transparent), 0 8px 24px -10px color-mix(in oklab, black 55%, transparent)" },
      "cairn-cta-bg": { "$value": "var(--color-base-200)", "$extensions": { "pub.cairn": { "unlayered": true } } },
      "cairn-cta-content": { "$value": "var(--color-base-content)", "$extensions": { "pub.cairn": { "unlayered": true } } },
