{
  "$description": "The fixture theme's tokens. Each token key is the CSS custom property name without its leading dashes.",
  "base": {
    "font-body": { "$type": "fontFamily", "$value": ["Georgia", "serif"] },
    "text-step-0": { "$value": "clamp(1rem, 0.95rem + 0.2vw, 1.1rem)" },
    "spacing-s": { "$value": "1em" },
    "spacing-m": { "$value": "1.5em" },
    "container-measure": { "$value": "60vw" },
    "leading-body": { "$type": "number", "$value": 1.65 },
    "color-card-border": { "$value": "color-mix(in oklab, var(--color-base-content) 9%, transparent)" }
  },
  "color": {
    "light": {
      "color-base-100": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.984, 0, 0] } },
      "color-base-200": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.964, 0, 0] } },
      "color-base-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.25, 0, 0] } },
      "color-primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.45, 0.1, 248] } },
      "color-primary-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.99, 0.01, 248] } },
      "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.52, 0.07, 235] } },
      "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.99, 0.01, 235] } },
      "color-info": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.1, 235] } },
      "cairn-info-ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.48, 0.1, 235] } },
      "radius-box": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "depth": { "$type": "number", "$value": 0 }
    },
    "dark": {
      "color-base-100": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.24, 0, 0] } },
      "color-base-200": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0] } },
      "color-base-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.92, 0, 0] } },
      "color-primary": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.74, 0.1, 248] } },
      "color-primary-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.03, 248] } },
      "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.76, 0.08, 235] } },
      "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.03, 235] } },
      "color-info": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.7, 0.1, 235] } },
      "cairn-info-ink": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.8, 0.1, 235] } },
      "radius-box": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "depth": { "$type": "number", "$value": 0 }
    }
  },
  "options": {
    "accent": {
      "ember": {
        "light": {
          "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.55, 0.16, 40] } },
          "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.99, 0.01, 40] } }
        },
        "dark": {
          "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.78, 0.13, 50] } },
          "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.03, 50] } }
        }
      },
      "tide": {
        "light": {
          "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.5, 0.12, 200] } },
          "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.99, 0.01, 200] } }
        },
        "dark": {
          "color-accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.75, 0.1, 195] } },
          "color-accent-content": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.22, 0.03, 195] } }
        }
      }
    }
  }
}
