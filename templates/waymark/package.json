{
  "name": "cairn-site",
  "private": true,
  "type": "module",
  "imports": {
    "#chassis/*": "./src/chassis/*",
    "#lib/*": "./src/lib/*",
    "#site/*": "./src/site/*",
    "#theme/*": "./src/theme/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "predev": "npm run build:admin-css",
    "dev:admin-css": "npx --no-install @tailwindcss/cli -i src/admin.css -o .cairn/admin.css --watch",
    "build": "vite build --logLevel warn",
    "prebuild": "npm run build:admin-css",
    "preview": "wrangler dev",
    "cairn:manifest": "cairn-manifest",
    "build:admin-css": "npx --no-install @tailwindcss/cli -i src/admin.css -o .cairn/admin.css",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "precheck": "npm run build:admin-css",
    "check:cairn": "npm run build:admin-css && cairn-audit",
    "format": "prettier --write --no-error-on-unmatched-pattern 'src/**/*.{ts,js,svelte,css}' 'e2e/**/*.ts' '*.ts' '*.js'",
    "format:check": "prettier --check --no-error-on-unmatched-pattern 'src/**/*.{ts,js,svelte,css}' 'e2e/**/*.ts' '*.ts' '*.js'",
    "pretest:unit": "svelte-kit sync",
    "test:unit": "vitest run",
    "cf-typegen": "wrangler types --env-file=.dev.vars.example --include-runtime=false"
  },
  "dependencies": {
    "@glw907/cairn-cms": "^0.99.0-rc.5",
    "hastscript": "^9.0.3",
    "remark-smartypants": "^3.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@glw907/cairn-cms-dev": "^0.99.0-rc.5",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "daisyui": "^5.7.50",
    "devalue": "^5.9.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
