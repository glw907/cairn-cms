
  Operate a cairn-cms production site.                                                                                  
                                                                                                                        
  To set up a new site, run `cairn new`. `cairn new --help` covers running it at a terminal and from an agent.          
  Run `cairn help agents` for the contract a program reads.                                                             
  Pass --json to a reporting command for a machine-readable payload on stdout.                                          
  Set CAIRN_PLAIN=1 to print plain output at a terminal, the same output a pipe receives.                               
  Exit codes: 0 OK, 1 WARNING, 2 CRITICAL, 3 UNKNOWN.                                                                   
         
  [1mUSAGE[m  
         
    cairn[38;2;168;164;158m [command][m[38;2;168;164;158m [--flags][m      
            
  [1mEXAMPLES[m  
            
    [38;2;168;164;158m# Check a site's health[m        
    $[38;2;168;164;158m [mcairn[38;2;168;164;158m [mhealth[38;2;168;164;158m [mmy-site-a1b2c3  
                                   
    [38;2;168;164;158m# Set up a new site[m            
    $[38;2;168;164;158m [mcairn[38;2;168;164;158m [mnew                    
                  
  [1mSITE COMMANDS:[m  
                  
    adopt[38;2;168;164;158m [command][m[38;2;168;164;158m [--flags][m  [38;2;168;164;158mAdd a Cloudflare Worker to the registry as a site[m
    doctor[38;2;168;164;158m [<dir>][m[38;2;168;164;158m [--flags][m   [38;2;168;164;158mCheck a cairn-cms site's configuration, no credential or deploy needed[m
    health[38;2;168;164;158m [<site>][m[38;2;168;164;158m [--flags][m  [38;2;168;164;158mRun the read-only health checks against one site, or every site when none is named[m
    logs <site>[38;2;168;164;158m [--flags][m      [38;2;168;164;158mRead one site's engine log records[m
    new[38;2;168;164;158m [command][m[38;2;168;164;158m [--flags][m    [38;2;168;164;158mSet up a new cairn site[m
    sites[38;2;168;164;158m [command][m[38;2;168;164;158m [--flags][m  [38;2;168;164;158mList the sites cairn knows[m
                        
  [1mCREDENTIAL COMMANDS:[m  
                        
    auth[38;2;168;164;158m [command][m             [38;2;168;164;158mManage credentials in the OS keyring[m
                   
  [1mOTHER COMMANDS:[m  
                   
    agents                     [38;2;168;164;158mPrint the contract a program or an agent reads[m
    completion[38;2;168;164;158m [command][m       [38;2;168;164;158mGenerate the autocompletion script for the specified shell[m
    help[38;2;168;164;158m [command][m             [38;2;168;164;158mHelp about any command[m
         
  [1mFLAGS[m  
         
    --ack-file                 [38;2;168;164;158mPath to a JSON file of holds (default: acknowledgements.json in the registry directory)[m
    --color                    [38;2;168;164;158mWhen to colour the output: auto, always, or never[m[38;2;168;164;158m (auto)[m
    -h --help                  [38;2;168;164;158mHelp for cairn[m
    -q --quiet                 [38;2;168;164;158mPrint nothing when the run is OK[m
    --theme                    [38;2;168;164;158mThe ground to render for: dark or light[m[38;2;168;164;158m (dark)[m
    -t --timeout               [38;2;168;164;158mWall-Clock budget for the whole run[m[38;2;168;164;158m (8m0s)[m
    -v --verbose               [38;2;168;164;158mPrint the identifiers a run otherwise withholds[m
    -V --version               [38;2;168;164;158mPrint the version and exit[m
