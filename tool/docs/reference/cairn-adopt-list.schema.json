{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.pub/schema/cairn-adopt-list.schema.json",
  "title": "cairn adopt list payload",
  "description": "The candidate listing `cairn adopt list` writes. It writes nothing to the registry, and every value in it is an identifier read off the account, which is what containsPersonalData names.",
  "type": "object",
  "required": ["schemaVersion", "kind", "verdict", "exitCode", "containsPersonalData", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "adoptCandidates" },
    "verdict": { "type": "string", "enum": ["OK", "WARNING", "CRITICAL", "UNKNOWN"] },
    "exitCode": { "type": "integer", "enum": [0, 1, 2, 3] },
    "containsPersonalData": { "type": "boolean" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["worker", "repo", "zone", "domain", "accountId", "connected", "adopted"],
        "additionalProperties": false,
        "properties": {
          "worker": { "type": "string" },
          "repo": { "type": "string" },
          "zone": { "type": "string" },
          "domain": { "type": "string" },
          "accountId": { "type": "string" },
          "connected": { "type": "boolean" },
          "adopted": { "type": "boolean" }
        }
      }
    }
  }
}
