{
  // Test-only Worker config consumed by @cloudflare/vitest-plugin.
  // This package is a library and is never deployed; this file exists solely
  // to give the integration tests a real miniflare D1 binding.
  "name": "cairn-cms-test",
  "compatibility_date": "2026-08-21",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "cairn-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "cairn-test-media"
    }
  ],
  // The engine reads PUBLIC_ORIGIN from the Worker env (`cloudflare:workers`), so the fixtures'
  // shared origin is a var here; a test that needs another origin, or none, layers it with
  // `withTestEnv` (src/tests/helpers/with-test-env.ts).
  "vars": {
    "PUBLIC_ORIGIN": "https://test.dev"
  }
}
